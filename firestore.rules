rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'Reyvanscom@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function getActivePinHash() {
      return exists(/databases/$(database)/documents/appConfigs/global)
        ? get(/databases/$(database)/documents/appConfigs/global).data.pinHash
        : 'sec_1cf7e71cc2a8a2';
    }

    function isTeacherPinAuthorized(authorToken) {
      return request.auth == null &&
        authorToken is string &&
        authorToken.size() >= 4 &&
        authorToken.size() <= 128 &&
        (authorToken == 'sec_1cf7e71cc2a8a2' || authorToken == getActivePinHash());
    }

    // Validation Blueprint: TopicOverride
    function isValidTopicOverride(data) {
      return data.keys().hasAll([
        'topicId',
        'title',
        'customVideoUrl',
        'customVideoTitle',
        'customMateriImageUrl',
        'customInfographicUrl',
        'authorId',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'topicId',
        'title',
        'customVideoUrl',
        'customVideoTitle',
        'customMateriImageUrl',
        'customInfographicUrl',
        'payloadJson',
        'authorId',
        'createdAt',
        'updatedAt'
      ]) &&
      data.topicId is string && data.topicId.size() >= 1 && data.topicId.size() <= 128 && data.topicId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 300 &&
      data.customVideoUrl is string && data.customVideoUrl.size() <= 1000 &&
      data.customVideoTitle is string && data.customVideoTitle.size() <= 300 &&
      data.customMateriImageUrl is string && data.customMateriImageUrl.size() <= 2000 &&
      data.customInfographicUrl is string && data.customInfographicUrl.size() <= 2000 &&
      (!('payloadJson' in data) || (data.payloadJson is string && data.payloadJson.size() <= 900000)) &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Validation Blueprint: AppSecurityConfig
    function isValidAppSecurityConfig(data) {
      return data.keys().hasAll([
        'configId',
        'pinHash',
        'teacherName',
        'teacherNIP',
        'teacherRole',
        'schoolName',
        'schoolAddress',
        'authorId',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'configId',
        'pinHash',
        'teacherName',
        'teacherNIP',
        'teacherRole',
        'schoolName',
        'schoolAddress',
        'authorId',
        'createdAt',
        'updatedAt'
      ]) &&
      data.configId is string && data.configId.size() >= 1 && data.configId.size() <= 128 && data.configId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.pinHash is string && data.pinHash.size() >= 4 && data.pinHash.size() <= 128 && data.pinHash.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.teacherName is string && data.teacherName.size() >= 1 && data.teacherName.size() <= 120 &&
      data.teacherNIP is string && data.teacherNIP.size() >= 1 && data.teacherNIP.size() <= 60 &&
      data.teacherRole is string && data.teacherRole.size() >= 1 && data.teacherRole.size() <= 120 &&
      data.schoolName is string && data.schoolName.size() >= 1 && data.schoolName.size() <= 120 &&
      data.schoolAddress is string && data.schoolAddress.size() >= 1 && data.schoolAddress.size() <= 250 &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Validation Blueprint: StudentScoreRecord
    function isValidStudentScoreRecord(data) {
      return data.keys().hasAll([
        'recordId',
        'studentName',
        'className',
        'studentNumber',
        'topicId',
        'topicTitle',
        'activityType',
        'activityName',
        'score',
        'authorId',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'recordId',
        'studentName',
        'className',
        'studentNumber',
        'topicId',
        'topicTitle',
        'activityType',
        'activityName',
        'score',
        'maxScore',
        'mode',
        'details',
        'authorId',
        'createdAt',
        'updatedAt'
      ]) &&
      data.recordId is string && data.recordId.size() >= 1 && data.recordId.size() <= 128 && data.recordId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 120 &&
      data.className is string && data.className.size() >= 1 && data.className.size() <= 60 &&
      data.studentNumber is string && data.studentNumber.size() >= 1 && data.studentNumber.size() <= 30 &&
      data.topicId is string && data.topicId.size() >= 1 && data.topicId.size() <= 128 && data.topicId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.topicTitle is string && data.topicTitle.size() >= 1 && data.topicTitle.size() <= 300 &&
      data.activityType is string && data.activityType in [
        'mini-game',
        'kuis',
        'asesmen-awal',
        'asesmen-akhir',
        'simulasi',
        'pbl',
        'profil'
      ] &&
      data.activityName is string && data.activityName.size() >= 1 && data.activityName.size() <= 200 &&
      data.score is int && data.score >= 0 && data.score <= 100000 &&
      (!('maxScore' in data) || (data.maxScore is int && data.maxScore >= 0 && data.maxScore <= 100000)) &&
      (!('mode' in data) || (data.mode is string && data.mode.size() >= 1 && data.mode.size() <= 60)) &&
      (!('details' in data) || (data.details is string && data.details.size() <= 500)) &&
      data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Collection: /admins/{adminId}
    match /admins/{adminId} {
      allow get: if isVerifiedUser() && isValidId(adminId) && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    // Collection: /topicOverrides/{topicId}
    match /topicOverrides/{topicId} {
      allow get: if isValidId(topicId) && (resource == null || existing().topicId == topicId);
      allow list: if isVerifiedUser() && (existing().authorId == request.auth.uid || isBootstrappedAdmin());

      allow create: if isValidId(topicId) &&
        isValidTopicOverride(incoming()) &&
        incoming().topicId == topicId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (isVerifiedUser() && incoming().authorId == request.auth.uid && isAdmin()) ||
          isTeacherPinAuthorized(incoming().authorId)
        );

      allow update: if isValidId(topicId) &&
        isValidTopicOverride(incoming()) &&
        incoming().topicId == existing().topicId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isVerifiedUser() &&
            incoming().authorId == existing().authorId &&
            (existing().authorId == request.auth.uid || isAdmin()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title',
              'customVideoUrl',
              'customVideoTitle',
              'customMateriImageUrl',
              'customInfographicUrl',
              'payloadJson',
              'updatedAt'
            ])
          ) ||
          (
            isTeacherPinAuthorized(incoming().authorId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title',
              'customVideoUrl',
              'customVideoTitle',
              'customMateriImageUrl',
              'customInfographicUrl',
              'payloadJson',
              'authorId',
              'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(topicId) &&
        (
          (isVerifiedUser() && (existing().authorId == request.auth.uid || isAdmin())) ||
          isTeacherPinAuthorized(existing().authorId)
        );
    }

    // Collection: /appConfigs/{configId}
    match /appConfigs/{configId} {
      allow get: if isValidId(configId) && (resource == null || existing().configId == configId);
      allow list: if isVerifiedUser() && (existing().authorId == request.auth.uid || isBootstrappedAdmin());

      allow create: if isValidId(configId) &&
        isValidAppSecurityConfig(incoming()) &&
        incoming().configId == configId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (isVerifiedUser() && incoming().authorId == request.auth.uid && isAdmin()) ||
          (request.auth == null && incoming().authorId == 'sec_1cf7e71cc2a8a2')
        );

      allow update: if isValidId(configId) &&
        isValidAppSecurityConfig(incoming()) &&
        incoming().configId == existing().configId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isVerifiedUser() &&
            incoming().authorId == existing().authorId &&
            (existing().authorId == request.auth.uid || isAdmin()) &&
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['pinHash', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly([
                'teacherName',
                'teacherNIP',
                'teacherRole',
                'schoolName',
                'schoolAddress',
                'updatedAt'
              ]) ||
              (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
                'pinHash',
                'teacherName',
                'teacherNIP',
                'teacherRole',
                'schoolName',
                'schoolAddress',
                'updatedAt'
              ]))
            )
          ) ||
          (
            request.auth == null &&
            (incoming().authorId == existing().pinHash || incoming().authorId == 'sec_1cf7e71cc2a8a2') &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'pinHash',
              'teacherName',
              'teacherNIP',
              'teacherRole',
              'schoolName',
              'schoolAddress',
              'authorId',
              'updatedAt'
            ])
          )
        );

      allow delete: if isVerifiedUser() &&
        isValidId(configId) &&
        isAdmin();
    }

    // Collection: /studentRecords/{recordId}
    match /studentRecords/{recordId} {
      allow get: if isValidId(recordId) && (resource == null || existing().recordId == recordId);
      allow list: if existing().recordId is string && existing().score >= 0;

      allow create: if isValidId(recordId) &&
        isValidStudentScoreRecord(incoming()) &&
        incoming().recordId == recordId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (isVerifiedUser() && incoming().authorId == request.auth.uid) ||
          (request.auth == null && incoming().authorId == 'student_web_client')
        );

      allow update: if isValidId(recordId) &&
        isValidStudentScoreRecord(incoming()) &&
        incoming().recordId == existing().recordId &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (isVerifiedUser() && (existing().authorId == request.auth.uid || isAdmin())) ||
          (request.auth == null && existing().authorId == 'student_web_client')
        ) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'studentName',
          'className',
          'studentNumber',
          'topicId',
          'topicTitle',
          'activityType',
          'activityName',
          'score',
          'maxScore',
          'mode',
          'details',
          'updatedAt'
        ]);

      allow delete: if isValidId(recordId) &&
        (
          (isVerifiedUser() && (existing().authorId == request.auth.uid || isAdmin())) ||
          (request.auth == null && existing().recordId == recordId)
        );
    }
  }
}
